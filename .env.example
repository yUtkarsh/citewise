# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
MODEL_NOTATION=claude-sonnet-5-5
MODEL_TABLES=claude-sonnet-5-5
MODEL_CLAUSES=claude-haiku-5-5
MODEL_AGENT=claude-sonnet-5-5
MODEL_REVIEW=claude-sonnet-5-5
MODEL_PROFILE=claude-sonnet-5-5
# MODEL_GLOBAL=claude-sonnet-5-5  # global pass inferred edges and merges; defaults to MODEL_REVIEW
CLAUSE_CROPS=always
SERVER_FALLBACK=1
EMBED_MODEL=BAAI/bge-small-en-v1.5
AGENT_EFFORT=medium
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
